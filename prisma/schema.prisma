generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Empresa: unidad de aislamiento (tenant). Todo dato operativo futuro colgará de empresaId.
model Empresa {
  id                   String   @id @default(uuid(7)) @db.Uuid
  razonSocial          String   @map("razon_social")
  nombreComercial      String?  @map("nombre_comercial")
  identificacionFiscal String   @unique @map("identificacion_fiscal")
  activa               Boolean  @default(true)
  creadoEn             DateTime @default(now()) @map("creado_en")
  actualizadoEn        DateTime @updatedAt @map("actualizado_en")

  roles    Rol[]
  miembros EmpresaUsuario[]
  archivos ArchivoAlmacenado[]

  iaProveedores  ConfiguracionProveedor[]
  iaAgentes      Agente[]
  iaAsignaciones AsignacionModelo[]
  iaEjecuciones  Ejecucion[]
  iaResultados   Resultado[]
  iaAprobaciones Aprobacion[]
  iaUso          RegistroUso[]

  terceros               Tercero[]
  operaciones            Operacion[]
  operacionesHistorial   OperacionHistorial[]
  documentos             Documento[]
  requisitosDocumentales RequisitoDocumento[]
  envios                 Envio[]
  eventosLogisticos      EventoLogistico[]
  costos                 Costo[]
  contadores             ContadorConsecutivo[]
  invitaciones           Invitacion[]

  productos             Producto[]
  bodegas               Bodega[]
  existenciasInventario ExistenciaInventario[]
  recepciones           Recepcion[]
  recepcionesLineas     RecepcionLinea[]
  movimientosInventario MovimientoInventario[]

  @@map("empresas")
}

model Usuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  correo        String   @unique
  nombre        String
  activo        Boolean  @default(true)
  emailVerified Boolean  @default(false) @map("correo_verificado")
  image         String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresas EmpresaUsuario[]
  sesiones Session[]
  cuentas  Account[]

  iaEjecuciones  Ejecucion[]
  iaAprobaciones Aprobacion[]
  iaUso          RegistroUso[]

  tercerosCreados       Tercero[]            @relation("TerceroCreador")
  operacionesCreadas    Operacion[]          @relation("OperacionCreador")
  historialOperaciones  OperacionHistorial[] @relation("HistorialUsuario")
  documentosSubidos     Documento[]          @relation("DocumentoAutor")
  eventosRegistrados    EventoLogistico[]    @relation("EventoAutor")
  costosRegistrados     Costo[]              @relation("CostoAutor")
  invitacionesRecibidas Invitacion[]         @relation("InvitacionUsuario")
  invitacionesCreadas   Invitacion[]         @relation("InvitacionAutor")

  productosCreados       Producto[]             @relation("ProductoCreador")
  bodegasCreadas         Bodega[]               @relation("BodegaCreador")
  bodegasResponsable     Bodega[]               @relation("BodegaResponsable")
  recepcionesRegistradas Recepcion[]            @relation("RecepcionAutor")
  movimientosRegistrados MovimientoInventario[] @relation("MovimientoAutor")

  @@map("usuarios")
}

// Tablas de Better Auth. Las credenciales viven solo en Account; los usuarios sin cuenta no pueden iniciar sesión.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expira_en")
  ipAddress String?  @map("ip")
  userAgent String?  @map("agente_usuario")
  userId    String   @map("usuario_id") @db.Uuid
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sesiones")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("cuenta_id")
  providerId            String    @map("proveedor")
  userId                String    @map("usuario_id") @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @map("hash_clave")
  createdAt             DateTime  @default(now()) @map("creado_en")
  updatedAt             DateTime  @updatedAt @map("actualizado_en")

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("cuentas")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expira_en")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("actualizado_en")

  @@index([identifier])
  @@map("verificaciones")
}

// Rol: pertenece a una sola empresa (los roles no se comparten entre empresas).
model Rol {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  nombre        String
  descripcion   String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa  Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  permisos RolPermiso[]
  miembros EmpresaUsuario[]

  @@unique([empresaId, nombre])
  @@unique([id, empresaId]) // habilita FK compuesta para garantizar rol de la misma empresa
  @@map("roles")
}

// Permiso: catálogo global (p. ej. "importaciones:leer").
model Permiso {
  id            String   @id @default(uuid(7)) @db.Uuid
  codigo        String   @unique
  descripcion   String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String   @map("rol_id") @db.Uuid
  permisoId String   @map("permiso_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

// Membresía: un usuario puede pertenecer a varias empresas, con un rol por empresa.
model EmpresaUsuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId, empresaId], references: [id, empresaId], onDelete: Restrict)

  operacionesResponsable Operacion[]

  @@unique([empresaId, usuarioId])
  @@index([usuarioId])
  @@map("empresa_usuarios")
}

// ---------------------------------------------------------------------------
// Centro de Inteligencia. Todo registro pertenece a una empresa (empresa_id) y las
// relaciones obligatorias usan claves foráneas compuestas (id, empresa_id) para impedir
// vínculos entre empresas. No se almacenan credenciales de proveedores.
// ---------------------------------------------------------------------------

enum ProveedorIA {
  OPENAI
  ANTHROPIC
  GOOGLE
  /// Proveedor simulado (pruebas sin costo): no llama a ningún servicio externo.
  SIMULADO

  @@map("proveedor_ia")
}

enum TipoAgente {
  ORQUESTADOR
  ESPECIALISTA

  @@map("tipo_agente")
}

enum EstadoEjecucion {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  FALLIDA
  CANCELADA

  @@map("estado_ejecucion")
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
  /// Devuelto al autor con observaciones para que lo corrija.
  DEVUELTO

  @@map("estado_aprobacion")
}

model ConfiguracionProveedor {
  id            String      @id @default(uuid(7)) @db.Uuid
  empresaId     String      @map("empresa_id") @db.Uuid
  proveedor     ProveedorIA
  habilitado    Boolean     @default(false)
  notas         String?
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  asignaciones AsignacionModelo[]

  @@unique([empresaId, proveedor])
  @@map("ia_proveedores")
}

model Agente {
  id            String     @id @default(uuid(7)) @db.Uuid
  empresaId     String     @map("empresa_id") @db.Uuid
  codigo        String
  nombre        String
  descripcion   String?
  tipo          TipoAgente @default(ESPECIALISTA)
  instrucciones String?
  activo        Boolean    @default(true)
  orquestadorId String?    @map("orquestador_id") @db.Uuid
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orquestador  Agente?            @relation("Orquestacion", fields: [orquestadorId], references: [id], onDelete: SetNull)
  subagentes   Agente[]           @relation("Orquestacion")
  asignaciones AsignacionModelo[]
  ejecuciones  Ejecucion[]

  @@unique([empresaId, codigo])
  @@unique([id, empresaId])
  @@map("ia_agentes")
}

// Proveedor y modelo asignados a un agente; editable sin cambiar código. Menor prioridad = se usa primero.
model AsignacionModelo {
  id            String      @id @default(uuid(7)) @db.Uuid
  empresaId     String      @map("empresa_id") @db.Uuid
  agenteId      String      @map("agente_id") @db.Uuid
  proveedor     ProveedorIA
  modelo        String
  prioridad     Int         @default(1)
  parametros    Json?
  activa        Boolean     @default(true)
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente                 Agente                 @relation(fields: [agenteId, empresaId], references: [id, empresaId], onDelete: Cascade)
  configuracionProveedor ConfiguracionProveedor @relation(fields: [empresaId, proveedor], references: [empresaId, proveedor], onDelete: Restrict)

  @@unique([agenteId, prioridad])
  @@index([empresaId])
  @@map("ia_asignaciones")
}

model Ejecucion {
  id               String          @id @default(uuid(7)) @db.Uuid
  empresaId        String          @map("empresa_id") @db.Uuid
  agenteId         String          @map("agente_id") @db.Uuid
  solicitadaPorId  String          @map("solicitada_por_id") @db.Uuid
  estado           EstadoEjecucion @default(PENDIENTE)
  entrada          Json?
  proveedor        ProveedorIA?
  modelo           String?
  error            String?
  ejecucionPadreId String?         @map("ejecucion_padre_id") @db.Uuid
  /// Huella del análisis (operación + documentos + versión): impide duplicados activos.
  huella           String?
  iniciadaEn       DateTime?       @map("iniciada_en")
  finalizadaEn     DateTime?       @map("finalizada_en")
  creadoEn         DateTime        @default(now()) @map("creado_en")
  actualizadoEn    DateTime        @updatedAt @map("actualizado_en")

  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente        Agente        @relation(fields: [agenteId, empresaId], references: [id, empresaId], onDelete: Restrict)
  solicitadaPor Usuario       @relation(fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  padre         Ejecucion?    @relation("Subejecuciones", fields: [ejecucionPadreId], references: [id], onDelete: SetNull)
  hijas         Ejecucion[]   @relation("Subejecuciones")
  resultados    Resultado[]
  usos          RegistroUso[]

  @@unique([id, empresaId])
  @@index([empresaId, creadoEn])
  @@index([empresaId, huella])
  @@map("ia_ejecuciones")
}

model Resultado {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  ejecucionId   String   @map("ejecucion_id") @db.Uuid
  titulo        String
  contenido     Json
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ejecucion  Ejecucion   @relation(fields: [ejecucionId, empresaId], references: [id, empresaId], onDelete: Cascade)
  aprobacion Aprobacion?

  @@unique([id, empresaId])
  @@index([empresaId, creadoEn])
  @@map("ia_resultados")
}

// Todo resultado requiere decisión humana: la base exige un usuario cuando el estado no es PENDIENTE.
model Aprobacion {
  id            String           @id @default(uuid(7)) @db.Uuid
  empresaId     String           @map("empresa_id") @db.Uuid
  resultadoId   String           @unique @map("resultado_id") @db.Uuid
  estado        EstadoAprobacion @default(PENDIENTE)
  decididaPorId String?          @map("decidida_por_id") @db.Uuid
  comentario    String?
  decididaEn    DateTime?        @map("decidida_en")
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @updatedAt @map("actualizado_en")

  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  resultado   Resultado @relation(fields: [resultadoId, empresaId], references: [id, empresaId], onDelete: Cascade)
  decididaPor Usuario?  @relation(fields: [decididaPorId], references: [id], onDelete: Restrict)

  @@unique([resultadoId, empresaId])
  @@index([empresaId, estado])
  @@map("ia_aprobaciones")
}

enum TipoUso {
  PRUEBA_CONEXION
  EJECUCION

  @@map("tipo_uso")
}

enum EstadoUso {
  EN_CURSO
  EXITOSA
  FALLIDA
  /// La API respondió, pero no generó texto útil.
  SIN_CONTENIDO

  @@map("estado_uso")
}

// Bitácora de llamadas a proveedores de IA: sin contenido de mensajes ni respuestas, solo metadatos.
model RegistroUso {
  id                 String      @id @default(uuid(7)) @db.Uuid
  empresaId          String      @map("empresa_id") @db.Uuid
  usuarioId          String      @map("usuario_id") @db.Uuid
  tipo               TipoUso
  proveedor          ProveedorIA
  modelo             String
  estado             EstadoUso   @default(EN_CURSO)
  codigoError        String?     @map("codigo_error")
  duracionMs         Int?        @map("duracion_ms")
  tokensEntrada      Int?        @map("tokens_entrada")
  tokensSalida       Int?        @map("tokens_salida")
  tokensRazonamiento Int?        @map("tokens_razonamiento")
  caracteresSalida   Int?        @map("caracteres_salida")
  motivoFin          String?     @map("motivo_fin")
  ejecucionId        String?     @map("ejecucion_id") @db.Uuid
  /// Hash de la autorización de un solo uso con la que se permitió una ejecución real.
  autorizacionHash   String?     @unique @map("autorizacion_hash")
  creadoEn           DateTime    @default(now()) @map("creado_en")
  actualizadoEn      DateTime    @updatedAt @map("actualizado_en")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ejecucion Ejecucion? @relation(fields: [ejecucionId], references: [id], onDelete: SetNull)

  @@index([empresaId, tipo, creadoEn])
  @@map("ia_uso")
}

// ---------------------------------------------------------------------------
// MVP de comercio exterior: terceros, operaciones, documentos, logística y costos.
// Todo registro lleva empresa_id; las relaciones usan claves compuestas (id, empresa_id)
// para impedir vínculos entre empresas. Las referencias opcionales se refuerzan con triggers.
// ---------------------------------------------------------------------------

enum RolTercero {
  PROVEEDOR
  CLIENTE
  AGENTE_ADUANA
  TRANSPORTADOR
  OPERADOR_LOGISTICO
  OTRO

  @@map("rol_tercero")
}

enum AmbitoTercero {
  NACIONAL
  INTERNACIONAL

  @@map("ambito_tercero")
}

enum TipoOperacion {
  IMPORTACION
  EXPORTACION

  @@map("tipo_operacion")
}

enum EstadoOperacion {
  BORRADOR
  EN_PREPARACION
  EN_TRANSITO
  EN_ADUANA
  FINALIZADA
  CANCELADA

  @@map("estado_operacion")
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP

  @@map("incoterm")
}

enum ModalidadTransporte {
  MARITIMO
  AEREO
  TERRESTRE
  MULTIMODAL

  @@map("modalidad_transporte")
}

enum TipoDocumento {
  FACTURA_COMERCIAL
  LISTA_EMPAQUE
  DOCUMENTO_TRANSPORTE
  CERTIFICADO_ORIGEN
  FICHA_TECNICA
  DECLARACION_ADUANERA
  POLIZA_SEGURO
  OTRO

  @@map("tipo_documento")
}

enum EstadoDocumento {
  PENDIENTE
  RECIBIDO
  OBSERVADO
  APROBADO

  @@map("estado_documento")
}

enum EstadoEnvio {
  PROGRAMADO
  EN_TRANSITO
  EN_PUERTO
  ENTREGADO
  RETRASADO

  @@map("estado_envio")
}

enum TipoEvento {
  HITO
  NOVEDAD

  @@map("tipo_evento")
}

enum SeveridadNovedad {
  BAJA
  MEDIA
  ALTA

  @@map("severidad_novedad")
}

enum CategoriaCosto {
  VALOR_COMERCIAL
  FLETE_INTERNACIONAL
  SEGURO
  GASTOS_PORTUARIOS
  AGENCIA_ADUANAS
  TRANSPORTE_NACIONAL
  ALMACENAMIENTO
  TRIBUTOS_ADUANEROS
  OTROS

  @@map("categoria_costo")
}

enum EstadoCosto {
  ESTIMADO
  REAL

  @@map("estado_costo")
}

model Tercero {
  id                   String        @id @default(uuid(7)) @db.Uuid
  empresaId            String        @map("empresa_id") @db.Uuid
  razonSocial          String        @map("razon_social")
  nombreComercial      String?       @map("nombre_comercial")
  identificacionFiscal String        @map("identificacion_fiscal")
  ambito               AmbitoTercero @default(NACIONAL)
  roles                RolTercero[]
  pais                 String
  ciudad               String?
  direccion            String?
  correo               String?
  telefono             String?
  contacto             String?
  activo               Boolean       @default(true)
  observaciones        String?
  creadoPorId          String        @map("creado_por_id") @db.Uuid
  creadoEn             DateTime      @default(now()) @map("creado_en")
  actualizadoEn        DateTime      @updatedAt @map("actualizado_en")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  creadoPor   Usuario     @relation("TerceroCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  operaciones Operacion[]
  envios      Envio[]

  productos Producto[]

  @@unique([empresaId, identificacionFiscal])
  @@unique([id, empresaId])
  @@index([empresaId, activo])
  @@map("terceros")
}

model ContadorConsecutivo {
  empresaId String @map("empresa_id") @db.Uuid
  nombre    String
  ultimo    Int    @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, nombre])
  @@map("contadores")
}

model Operacion {
  id            String              @id @default(uuid(7)) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  consecutivo   Int
  numero        String
  tipo          TipoOperacion
  estado        EstadoOperacion     @default(BORRADOR)
  fechaApertura DateTime            @map("fecha_apertura") @db.Date
  descripcion   String
  terceroId     String              @map("tercero_id") @db.Uuid
  paisOrigen    String              @map("pais_origen")
  paisDestino   String              @map("pais_destino")
  incoterm      Incoterm
  lugarIncoterm String              @map("lugar_incoterm")
  moneda        String              @db.VarChar(3)
  valorEstimado Decimal             @map("valor_estimado") @db.Decimal(18, 2)
  modalidad     ModalidadTransporte
  responsableId String              @map("responsable_id") @db.Uuid
  observaciones String?
  creadoPorId   String              @map("creado_por_id") @db.Uuid
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  empresa     Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tercero     Tercero              @relation(fields: [terceroId, empresaId], references: [id, empresaId], onDelete: Restrict)
  responsable EmpresaUsuario       @relation(fields: [empresaId, responsableId], references: [empresaId, usuarioId], onDelete: Restrict)
  creadoPor   Usuario              @relation("OperacionCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  historial   OperacionHistorial[]
  documentos  Documento[]
  envio       Envio?
  eventos     EventoLogistico[]
  costos      Costo[]

  recepciones           Recepcion[]
  movimientosInventario MovimientoInventario[]

  @@unique([empresaId, consecutivo])
  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, creadoEn])
  @@map("operaciones")
}

model OperacionHistorial {
  id          String   @id @default(uuid(7)) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  operacionId String   @map("operacion_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  accion      String
  detalle     Json?
  creadoEn    DateTime @default(now()) @map("creado_en")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion Operacion @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Cascade)
  usuario   Usuario   @relation("HistorialUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([operacionId, creadoEn])
  @@map("operaciones_historial")
}

model Documento {
  id                  String          @id @default(uuid(7)) @db.Uuid
  empresaId           String          @map("empresa_id") @db.Uuid
  operacionId         String          @map("operacion_id") @db.Uuid
  tipo                TipoDocumento
  estado              EstadoDocumento @default(RECIBIDO)
  nombreOriginal      String          @map("nombre_original")
  claveAlmacenamiento String          @unique @map("clave_almacenamiento")
  tamanoBytes         Int             @map("tamano_bytes")
  tipoMime            String          @map("tipo_mime")
  sha256              String
  observaciones       String?
  subidoPorId         String          @map("subido_por_id") @db.Uuid
  creadoEn            DateTime        @default(now()) @map("creado_en")
  actualizadoEn       DateTime        @updatedAt @map("actualizado_en")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion Operacion @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Restrict)
  subidoPor Usuario   @relation("DocumentoAutor", fields: [subidoPorId], references: [id], onDelete: Restrict)

  recepciones Recepcion[]

  @@index([empresaId, estado])
  @@index([operacionId, tipo])
  @@map("documentos")
}

// Lista configurable de documentos exigidos por tipo de operación (si no hay filas, rigen los valores predeterminados).
model RequisitoDocumento {
  id            String        @id @default(uuid(7)) @db.Uuid
  empresaId     String        @map("empresa_id") @db.Uuid
  tipoOperacion TipoOperacion @map("tipo_operacion")
  tipoDocumento TipoDocumento @map("tipo_documento")
  obligatorio   Boolean       @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipoOperacion, tipoDocumento])
  @@map("requisitos_documentales")
}

model Envio {
  id                   String               @id @default(uuid(7)) @db.Uuid
  empresaId            String               @map("empresa_id") @db.Uuid
  operacionId          String               @map("operacion_id") @db.Uuid
  medioTransporte      ModalidadTransporte? @map("medio_transporte")
  numeroGuia           String?              @map("numero_guia")
  transportadorId      String?              @map("transportador_id") @db.Uuid
  puertoOrigen         String?              @map("puerto_origen")
  puertoDestino        String?              @map("puerto_destino")
  fechaEstimadaSalida  DateTime?            @map("fecha_estimada_salida") @db.Date
  fechaRealSalida      DateTime?            @map("fecha_real_salida") @db.Date
  fechaEstimadaLlegada DateTime?            @map("fecha_estimada_llegada") @db.Date
  fechaRealLlegada     DateTime?            @map("fecha_real_llegada") @db.Date
  estadoEnvio          EstadoEnvio          @default(PROGRAMADO) @map("estado_envio")
  creadoEn             DateTime             @default(now()) @map("creado_en")
  actualizadoEn        DateTime             @updatedAt @map("actualizado_en")

  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion     Operacion @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Cascade)
  transportador Tercero?  @relation(fields: [transportadorId], references: [id], onDelete: Restrict)

  @@unique([operacionId, empresaId])
  @@unique([operacionId])
  @@index([empresaId, fechaEstimadaLlegada])
  @@map("envios")
}

model EventoLogistico {
  id              String            @id @default(uuid(7)) @db.Uuid
  empresaId       String            @map("empresa_id") @db.Uuid
  operacionId     String            @map("operacion_id") @db.Uuid
  tipo            TipoEvento
  titulo          String
  descripcion     String?
  fechaEvento     DateTime          @map("fecha_evento")
  severidad       SeveridadNovedad?
  resuelta        Boolean           @default(false)
  resueltaEn      DateTime?         @map("resuelta_en")
  registradoPorId String            @map("registrado_por_id") @db.Uuid
  creadoEn        DateTime          @default(now()) @map("creado_en")
  actualizadoEn   DateTime          @updatedAt @map("actualizado_en")

  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion     Operacion @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Restrict)
  registradoPor Usuario   @relation("EventoAutor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([operacionId, fechaEvento])
  @@index([empresaId, tipo, resuelta])
  @@map("eventos_logisticos")
}

model Costo {
  id              String         @id @default(uuid(7)) @db.Uuid
  empresaId       String         @map("empresa_id") @db.Uuid
  operacionId     String         @map("operacion_id") @db.Uuid
  categoria       CategoriaCosto
  concepto        String
  valor           Decimal        @db.Decimal(18, 2)
  moneda          String         @db.VarChar(3)
  fecha           DateTime       @db.Date
  estado          EstadoCosto
  observacion     String?
  registradoPorId String         @map("registrado_por_id") @db.Uuid
  creadoEn        DateTime       @default(now()) @map("creado_en")
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en")

  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion     Operacion @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Restrict)
  registradoPor Usuario   @relation("CostoAutor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([operacionId, estado])
  @@index([empresaId, moneda])
  @@map("costos")
}

// Invitación de un solo uso para que un usuario nuevo defina su propia contraseña. Solo se guarda el hash del token.
model Invitacion {
  id          String    @id @default(uuid(7)) @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiraEn    DateTime  @map("expira_en")
  usadaEn     DateTime? @map("usada_en")
  creadoPorId String    @map("creado_por_id") @db.Uuid
  creadoEn    DateTime  @default(now()) @map("creado_en")

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation("InvitacionUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoPor Usuario @relation("InvitacionAutor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("invitaciones")
}

// ---------------------------------------------------------------------------
// Inventarios. Existencias separadas por empresa, producto y bodega. Los saldos son decimales exactos
// (NUMERIC) y nunca pueden ser negativos (CHECK). Los movimientos son inmutables: las correcciones se
// hacen con movimientos compensatorios. Relaciones obligatorias con claves compuestas (id, empresa_id);
// las opcionales se refuerzan con triggers.
// ---------------------------------------------------------------------------

enum UnidadMedida {
  UNIDAD
  KILOGRAMO
  GRAMO
  LITRO
  METRO
  METRO_CUADRADO
  METRO_CUBICO
  CAJA
  PAR

  @@map("unidad_medida")
}

enum TipoMovimiento {
  RECEPCION
  ENTRADA
  SALIDA
  TRANSFERENCIA
  AJUSTE
  COMPENSACION

  @@map("tipo_movimiento")
}

enum SentidoMovimiento {
  ENTRADA
  SALIDA

  @@map("sentido_movimiento")
}

model Producto {
  id                String       @id @default(uuid(7)) @db.Uuid
  empresaId         String       @map("empresa_id") @db.Uuid
  sku               String
  nombre            String
  descripcion       String?
  categoria         String?
  unidad            UnidadMedida @default(UNIDAD)
  paisOrigen        String?      @map("pais_origen")
  /// Dato informativo sujeto a validación aduanera; el sistema no lo verifica.
  codigoArancelario String?      @map("codigo_arancelario")
  proveedorId       String?      @map("proveedor_id") @db.Uuid
  stockMinimo       Decimal      @default(0) @map("stock_minimo") @db.Decimal(18, 4)
  activo            Boolean      @default(true)
  creadoPorId       String       @map("creado_por_id") @db.Uuid
  creadoEn          DateTime     @default(now()) @map("creado_en")
  actualizadoEn     DateTime     @updatedAt @map("actualizado_en")

  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  proveedor   Tercero?               @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  creadoPor   Usuario                @relation("ProductoCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  existencias ExistenciaInventario[]
  movimientos MovimientoInventario[]
  lineas      RecepcionLinea[]

  @@unique([empresaId, sku])
  @@unique([id, empresaId])
  @@index([empresaId, activo])
  @@map("productos")
}

model Bodega {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  codigo        String
  nombre        String
  direccion     String?
  ciudad        String?
  responsableId String?  @map("responsable_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoPorId   String   @map("creado_por_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  responsable Usuario?               @relation("BodegaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  creadoPor   Usuario                @relation("BodegaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  existencias ExistenciaInventario[]
  movimientos MovimientoInventario[]
  recepciones Recepcion[]

  @@unique([empresaId, codigo])
  @@unique([id, empresaId])
  @@index([empresaId, activo])
  @@map("bodegas")
}

// Saldo vigente por producto y bodega. Se modifica solo dentro de la transacción que crea el movimiento.
model ExistenciaInventario {
  empresaId     String   @map("empresa_id") @db.Uuid
  productoId    String   @map("producto_id") @db.Uuid
  bodegaId      String   @map("bodega_id") @db.Uuid
  cantidad      Decimal  @default(0) @db.Decimal(18, 4)
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId, empresaId], references: [id, empresaId], onDelete: Restrict)
  bodega   Bodega   @relation(fields: [bodegaId, empresaId], references: [id, empresaId], onDelete: Restrict)

  @@id([productoId, bodegaId])
  @@index([empresaId, bodegaId])
  @@map("existencias")
}

model Recepcion {
  id                String   @id @default(uuid(7)) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  numero            String
  operacionId       String   @map("operacion_id") @db.Uuid
  bodegaId          String   @map("bodega_id") @db.Uuid
  fechaRecepcion    DateTime @map("fecha_recepcion") @db.Date
  documentoId       String?  @map("documento_id") @db.Uuid
  /// Token generado por el formulario: un reenvío con el mismo token nunca duplica la recepción.
  claveIdempotencia String   @map("clave_idempotencia")
  observaciones     String?
  registradoPorId   String   @map("registrado_por_id") @db.Uuid
  creadoEn          DateTime @default(now()) @map("creado_en")

  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operacion     Operacion              @relation(fields: [operacionId, empresaId], references: [id, empresaId], onDelete: Restrict)
  bodega        Bodega                 @relation(fields: [bodegaId, empresaId], references: [id, empresaId], onDelete: Restrict)
  documento     Documento?             @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  registradoPor Usuario                @relation("RecepcionAutor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  lineas        RecepcionLinea[]
  movimientos   MovimientoInventario[]

  @@unique([empresaId, numero])
  @@unique([empresaId, claveIdempotencia])
  @@unique([id, empresaId])
  @@index([empresaId, creadoEn])
  @@index([operacionId])
  @@map("recepciones")
}

model RecepcionLinea {
  id               String   @id @default(uuid(7)) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  recepcionId      String   @map("recepcion_id") @db.Uuid
  productoId       String   @map("producto_id") @db.Uuid
  cantidadEsperada Decimal? @map("cantidad_esperada") @db.Decimal(18, 4)
  cantidadRecibida Decimal  @map("cantidad_recibida") @db.Decimal(18, 4)
  observacion      String?

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  recepcion Recepcion @relation(fields: [recepcionId, empresaId], references: [id, empresaId], onDelete: Restrict)
  producto  Producto  @relation(fields: [productoId, empresaId], references: [id, empresaId], onDelete: Restrict)

  @@unique([recepcionId, productoId])
  @@map("recepciones_lineas")
}

// Inmutable: un trigger impide UPDATE y DELETE. Cada fila afecta a UNA bodega.
model MovimientoInventario {
  id                String            @id @default(uuid(7)) @db.Uuid
  empresaId         String            @map("empresa_id") @db.Uuid
  productoId        String            @map("producto_id") @db.Uuid
  bodegaId          String            @map("bodega_id") @db.Uuid
  tipo              TipoMovimiento
  sentido           SentidoMovimiento
  cantidad          Decimal           @db.Decimal(18, 4)
  /// Saldo del producto en la bodega inmediatamente después del movimiento.
  saldoPosterior    Decimal           @map("saldo_posterior") @db.Decimal(18, 4)
  motivo            String?
  referencia        String?
  /// Une las dos filas de una transferencia (o las compensaciones de un mismo grupo).
  grupoId           String?           @map("grupo_id") @db.Uuid
  recepcionId       String?           @map("recepcion_id") @db.Uuid
  operacionId       String?           @map("operacion_id") @db.Uuid
  compensaDeId      String?           @unique @map("compensa_de_id") @db.Uuid
  claveIdempotencia String?           @map("clave_idempotencia")
  usuarioId         String            @map("usuario_id") @db.Uuid
  creadoEn          DateTime          @default(now()) @map("creado_en")

  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  producto      Producto              @relation(fields: [productoId, empresaId], references: [id, empresaId], onDelete: Restrict)
  bodega        Bodega                @relation(fields: [bodegaId, empresaId], references: [id, empresaId], onDelete: Restrict)
  recepcion     Recepcion?            @relation(fields: [recepcionId], references: [id], onDelete: Restrict)
  operacion     Operacion?            @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  compensaDe    MovimientoInventario? @relation("Compensacion", fields: [compensaDeId], references: [id], onDelete: Restrict)
  compensadoPor MovimientoInventario? @relation("Compensacion")
  usuario       Usuario               @relation("MovimientoAutor", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([empresaId, claveIdempotencia])
  @@unique([id, empresaId])
  @@index([empresaId, creadoEn])
  @@index([productoId, bodegaId, creadoEn])
  @@index([grupoId])
  @@map("movimientos_inventario")
}

// Archivos privados cuando el almacenamiento es "postgres" (despliegues sin disco persistente, p. ej. Vercel).
// La clave es la misma que usa el almacenamiento local (<empresa>/<operación>/<archivo>.pdf); el contenido nunca se expone por URL pública.
model ArchivoAlmacenado {
  clave       String   @id
  empresaId   String   @map("empresa_id") @db.Uuid
  contenido   Bytes
  tamanoBytes Int      @map("tamano_bytes")
  creadoEn    DateTime @default(now()) @map("creado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("archivos_almacenados")
}
