generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Empresa: unidad de aislamiento (tenant). Todo dato operativo futuro colgará de empresaId.
model Empresa {
  id                   String   @id @default(uuid(7)) @db.Uuid
  razonSocial          String   @map("razon_social")
  nombreComercial      String?  @map("nombre_comercial")
  identificacionFiscal String   @unique @map("identificacion_fiscal")
  activa               Boolean  @default(true)
  creadoEn             DateTime @default(now()) @map("creado_en")
  actualizadoEn        DateTime @updatedAt @map("actualizado_en")

  roles    Rol[]
  miembros EmpresaUsuario[]

  @@map("empresas")
}

model Usuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  correo        String   @unique
  nombre        String
  activo        Boolean  @default(true)
  emailVerified Boolean  @default(false) @map("correo_verificado")
  image         String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresas EmpresaUsuario[]
  sesiones Session[]
  cuentas  Account[]

  @@map("usuarios")
}

// Tablas de Better Auth. Las credenciales viven solo en Account; los usuarios sin cuenta no pueden iniciar sesión.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expira_en")
  ipAddress String?  @map("ip")
  userAgent String?  @map("agente_usuario")
  userId    String   @map("usuario_id") @db.Uuid
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sesiones")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("cuenta_id")
  providerId            String    @map("proveedor")
  userId                String    @map("usuario_id") @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @map("hash_clave")
  createdAt             DateTime  @default(now()) @map("creado_en")
  updatedAt             DateTime  @updatedAt @map("actualizado_en")

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("cuentas")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expira_en")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("actualizado_en")

  @@index([identifier])
  @@map("verificaciones")
}

// Rol: pertenece a una sola empresa (los roles no se comparten entre empresas).
model Rol {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  nombre        String
  descripcion   String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa  Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  permisos RolPermiso[]
  miembros EmpresaUsuario[]

  @@unique([empresaId, nombre])
  @@unique([id, empresaId]) // habilita FK compuesta para garantizar rol de la misma empresa
  @@map("roles")
}

// Permiso: catálogo global (p. ej. "importaciones:leer").
model Permiso {
  id            String   @id @default(uuid(7)) @db.Uuid
  codigo        String   @unique
  descripcion   String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String   @map("rol_id") @db.Uuid
  permisoId String   @map("permiso_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

// Membresía: un usuario puede pertenecer a varias empresas, con un rol por empresa.
model EmpresaUsuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId, empresaId], references: [id, empresaId], onDelete: Restrict)

  @@unique([empresaId, usuarioId])
  @@index([usuarioId])
  @@map("empresa_usuarios")
}
