POSTGRES_USER=comext
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=comercio_exterior
POSTGRES_PORT=5433
DATABASE_URL="postgresql://comext:cambiar_esta_clave@localhost:5433/comercio_exterior?schema=public"
TEST_DATABASE_URL="postgresql://comext:cambiar_esta_clave@localhost:5433/comercio_exterior_test?schema=public"
BETTER_AUTH_SECRET=generar_con_openssl_rand_base64_48
BETTER_AUTH_URL=http://localhost:3000

# --- Centro de Inteligencia (solo servidor; nunca en el navegador ni en la base de datos) ---
# OPENAI_API_KEY=
# OPENAI_MODELOS_PERMITIDOS=gpt-5-mini,gpt-5
# Autoriza las pruebas reales de conexi�n. Dejar sin definir salvo durante una prueba autorizada.
# IA_PRUEBA_REAL_AUTORIZADA=true

# --- MVP de comercio exterior ---
# Carpeta privada de documentos PDF (fuera de /public). Por defecto ./storage (ignorada por Git).
# STORAGE_DIR=
# Zona horaria de la empresa para fechas por defecto y horas mostradas.
# APP_TIMEZONE=America/Bogota

# --- Despliegue remoto de QA (Vercel). Los valores reales se configuran SOLO en Vercel; ver docs/DESPLIEGUE_QA.md ---
# APP_ENV=qa                      # marca el entorno de pruebas (aviso en pantalla, noindex, IA desactivada)
# BETTER_AUTH_URL=https://<dominio-qa>.vercel.app   # https obligatorio; es el único origen confiable
# DATABASE_URL=                   # PostgreSQL gestionado EXCLUSIVO de QA (URL con pooler)
# DIRECT_URL=                     # misma base, conexión directa (migraciones)
# DB_POOL_MAX=3                   # conexiones por instancia serverless
# STORAGE_DRIVER=postgres         # local (desarrollo, por defecto) | postgres (Vercel)
# DOCUMENTOS_MAX_MB=4             # Vercel limita el cuerpo de las solicitudes a ~4,5 MB
# IA_QA_HABILITADA=true           # solo si se decide habilitar OpenAI en QA (junto con OPENAI_API_KEY)
